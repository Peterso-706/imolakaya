APP_NAME="ImoLakaya API"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/imolakaya
DATABASE_ECHO=false
SECRET_KEY=<generate-32-chars-min>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
STORAGE_PROVIDER=cloudinary
CLOUDINARY_URL=
CLOUDINARY_FOLDER=imolakaya
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=imolakaya
R2_PUBLIC_URL=
MONCASH_API_URL=https://sandbox.moncashbutton.digicelgroup.com/Api
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_WEBHOOK_SECRET=
NATCASH_API_URL=
NATCASH_API_KEY=
NATCASH_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=noreply@imolakaya.com
EMAIL_ENABLED=false
RATE_LIMIT_PER_MINUTE=60